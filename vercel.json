{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/enem-daily/browser",
  "rewrites": [
    { "source": "/((?!.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(ngsw-worker.js|ngsw.json|index.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
